# Python environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# System
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Trained estimators are build artifacts, not sources. An earlier version of
# this repository shipped four pickles trained under a labelling bug, and they
# outlived the fix by two months because nothing regenerates a committed file.
models/*.pkl

# reports/benchmark.json and reports/experiments.json are versioned on purpose:
# the README quotes their figures, and a verifiable claim ships with its proof.
# Reports written under any other name are local trials.
reports/*
!reports/benchmark.json
!reports/experiments.json
!reports/deployment.json
